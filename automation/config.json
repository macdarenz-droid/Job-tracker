  "contact": {
    "rule": "A direct contact is a named person in an engineering, drafting, design, operations, project or owner/director role at the employer whose business email is published by the employer itself (website team or contact page, project page, capability statement PDF, press release, tender or council document authored by the employer). Record the evidence URL and the date checked.",
    "never": [
      "guess or pattern-build an address",
      "use a personal (gmail, hotmail, outlook) address",
      "use data brokers, lead-generation or email-finder services",
      "use recruiters, agencies or unrelated project parties",
      "use a generic info@ or admin@ inbox unless the employer says it accepts applications"
    ],
    "fallback_order": [
      "employer HR, careers or application inbox that explicitly accepts applications",
      "SEEK apply or the employer portal, prepared for Jeremie or Marc"
    ],
    "double_touch": "When an advert must be applied for through SEEK or a portal AND a verified direct contact exists, prepare both: the portal pack for Marc and a short email to the contact saying the formal application has been (or will be) lodged. Never send the email before the portal application is marked Applied."
  },
